# Template of the variables the API needs. Committed to Git, so it holds no real values.
# Real values live in Vercel (Settings → Environment Variables) and in your .env.local,
# which Git ignores. On a new computer, `vercel env pull .env.local` fills it from the
# Vercel Development environment, which points at cwo-dev. Never put cwo-prod values here.

# Supabase cwo-dev → Project Settings → API: project URL and the secret key (sb_secret_…).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Resend → API Keys. Left empty in development on purpose: e-mails are then not sent
# (only logged as failed), so local testing cannot e-mail anyone by mistake.
RESEND_API_KEY=
# Optional: overrides the sender until the domain is verified, e.g. onboarding@resend.dev.
EMAIL_FROM=
SITE_URL=https://czechweightliftingopen.cz

# Optional, only for the Supabase CLI and the backup scripts run by hand (migrations,
# restore). Keep the passwords in a password manager; `vercel env pull` does not have them
# and overwrites this file, so copy them back in after pulling.
SUPABASE_DB_PASSWORD_DEV=
SUPABASE_DB_PASSWORD_PROD=
